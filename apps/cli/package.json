{
  "name": "anyagent",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "bin": {
    "anybot": "./dist/main.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -b",
    "typecheck": "tsc -b --pretty false",
    "test": "tsc -b && vitest run --config ../../vitest.config.ts --project anyagent"
  },
  "dependencies": {
    "@anyagent/admin": "workspace:*",
    "@anyagent/backend": "workspace:*",
    "@anyagent/backend-anytype": "workspace:*",
    "@anyagent/core": "workspace:*",
    "@anyagent/gateway": "workspace:*",
    "@anyagent/harness": "workspace:*",
    "@anyagent/node": "workspace:*",
    "@anyagent/workflows": "workspace:*",
    "@temporalio/client": "1.24.0",
    "@temporalio/worker": "1.24.0",
    "yaml": "2.9.1"
  },
  "devDependencies": {
    "@temporalio/testing": "1.24.0",
    "typescript": "5.9.3",
    "vitest": "5.1.0"
  }
}
